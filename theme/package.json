{
  "name": "slidev-theme-ua-talk",
  "private": true,
  "version": "0.1.0",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "slidev": ">=52.0.0"
  },
  "slidev": {
    "colorSchema": "dark",
    "defaults": {
      "canvasWidth": 1280,
      "aspectRatio": "16/9",
      "transition": "none",
      "fonts": {
        "provider": "none"
      },
      "drawings": {
        "enabled": false
      },
      "mdc": true
    }
  }
}
